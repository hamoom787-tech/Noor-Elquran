# Quran Reels Video Generator - Git Ignore

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environment
.venv/
venv/
env/
ENV/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# Temporary files
audio/*.mp3
audio/*.wav
audio/*.txt
!audio/.gitkeep

# Output videos
outputs/*.mp4
outputs/*.avi
outputs/*.mov
outputs/*.mkv
outputs/*.ts
outputs/*.json
outputs/*.txt
!outputs/.gitkeep

# Cached data
data/*.json
data/temp_segments_*/
data/**/*.png
data/**/*.ts
data/**/*.mp4
!data/.gitkeep

# Local generated notes
_audio_editions.txt

# OS files
.DS_Store
Thumbs.db
desktop.ini

# Logs
*.log

# Local secrets
.env

# Don't ignore vision folder README
!vision/README.md
